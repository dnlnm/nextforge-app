# --- Expo-specific env (NOT shared with the root `.env`) ---
#
# Expo cannot read parent-directory `.env` files, so these EXPO_PUBLIC_*
# values live here and mirror the shared values in the repository root
# `.env` (see the `.env.example` at the repo root). Keep them in sync.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=
