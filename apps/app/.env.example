# --- OVERRIDES ONLY ---
#
# Shared environment variables are defined once, at the repository root
# (`./.env.example` / `./.env`). This file holds only app-specific overrides
# for `apps/app`.
#
# To local-development: copy the root `.env.example` to `.env` (root) and fill
# in values. Anything listed here overrides the root value for this app.

NEXT_PUBLIC_MAIN_DOMAIN="klio.my"
NEXT_PUBLIC_APP_URL="https://app.klio.my"
NEXT_PUBLIC_WEB_URL="https://klio.my"
VERCEL_PROJECT_PRODUCTION_URL="https://app.klio.my"
