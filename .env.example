# =============================================================================
# SINGLE SOURCE OF TRUTH — repository-root environment (TEMPLATE)
#
# Copy this file to `.env` at the repository root and fill in real values.
# Every workspace reads shared values from the root `.env`:
#   - Next.js apps (apps/web, apps/api, apps/app) load it via the shared
#     loader in `packages/config/load-env.ts` (wired in each next.config.ts).
#   - Prisma (packages/database) loads it from `prisma.config.ts`.
#   - App-specific overrides only live in each app's `.env.local`
#     (e.g. NEXT_PUBLIC_API_URL, VERCEL_PROJECT_PRODUCTION_URL).
#   - Expo (apps/mobile) cannot read parent dirs; keep its EXPO_PUBLIC_*
#     mirrored in `apps/mobile/.env.local`.
#
# Consumers (apps/packages that actually read each var):
#   web  = apps/web | api = apps/api | app = apps/app | db = packages/database
#   mobile = apps/mobile (EXPO_PUBLIC_* only)
# =============================================================================

# --- Supabase ---
# consumers: web, api, app, mobile(EXPO_PUBLIC_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# --- Postgres (shared transaction-mode pooler for runtime) ---
# consumers: web, api, app, db
DATABASE_URL=""

# --- Postgres (shared session-mode pooler, for migrations) ---
# consumers: web, api, app, db
DIRECT_URL=""

# --- Stripe ---
# consumers: api, app
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
KLIO_STRIPE_STARTER_PRICE_ID=""
KLIO_STRIPE_PRO_PRICE_ID=""

# --- Resend ---
# consumers: web, api, app
RESEND_TOKEN=""
RESEND_FROM=""

# --- Vercel Blob ---
# consumers: app
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""

# --- Cloudflare R2 ---
# consumers: app
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BUCKET_NAME=""
R2_PUBLIC_URL=""
R2_PRIVATE_BUCKET_NAME=""

# --- CMS ---
# consumers: web
BASEHUB_TOKEN=""

# --- Admin ---
# consumers: api, app
KLIO_SUPERADMIN_USER_IDS=""

# --- Branding / URL defaults (apps may override in their .env.example / .env.local) ---
# consumers: web, api, app
#
# Production topology:
#   MAIN_DOMAIN = klio.my            (domain root; used for workspace subdomains + cookies)
#   APP_URL     = https://app.klio.my   (product app)
#   WEB_URL     = https://klio.my       (marketing / landing)
#   API_URL     = https://api.klio.my   (api)
#   DOCS_URL    = https://docs.klio.my  (optional docs)
NEXT_PUBLIC_APP_NAME=""
NEXT_PUBLIC_MAIN_DOMAIN=""
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_WEB_URL=""
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_DOCS_URL=""

# --- Optional / not yet configured (leave empty unless set up) ---
# RESEND_FROM / GA / PostHog / Betterstack / Flags / ArcJet / Svix /
# Liveblocks / Knock / Languine(PROJECT_ID) / Upstash / OpenAI / Sentry etc.
