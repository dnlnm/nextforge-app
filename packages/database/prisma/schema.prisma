generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                                         String                   @id @default(cuid())
  authUserId                                                 String                   @unique
  email                                                      String?
  firstName                                                  String?
  lastName                                                   String?
  imageUrl                                                   String?
  preferredLocale                                            String                   @default("en")
  createdAt                                                  DateTime                 @default(now())
  updatedAt                                                  DateTime                 @updatedAt
  archivedAt                                                 DateTime?
  attendanceRecords                                          AttendanceRecord[]
  auditEvents                                                AuditEvent[]             @relation("ActorAuditEvents")
  createdOrganizations                                       Organization[]           @relation("CreatedOrganizations")
  memberships                                                OrganizationMembership[]
  recordedPayments                                           Payment[]
  TeacherInvitation_TeacherInvitation_acceptedByUserIdToUser TeacherInvitation[]      @relation("TeacherInvitation_acceptedByUserIdToUser")
  TeacherInvitation_TeacherInvitation_invitedByUserIdToUser  TeacherInvitation[]      @relation("TeacherInvitation_invitedByUserIdToUser")
  TeacherProfile                                             TeacherProfile[]

  @@index([email])
}

model Organization {
  id                String                    @id @default(cuid())
  name              String
  slug              String                    @unique
  imageUrl          String?
  status            OrganizationStatus        @default(ACTIVE)
  createdByUserId   String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  archivedAt        DateTime?
  attendanceRecords AttendanceRecord[]
  auditEvents       AuditEvent[]
  branch            Branch?
  classSessions     ClassSession[]
  enrollments       Enrollment[]
  guardians         Guardian[]
  invoices          Invoice[]
  classes           LearningClass[]
  createdBy         User?                     @relation("CreatedOrganizations", fields: [createdByUserId], references: [id])
  memberships       OrganizationMembership[]
  settings          OrganizationSettings?
  subscription      OrganizationSubscription?
  payments          Payment[]
  students          Student[]
  subjects          Subject[]
  levels            Level[]
  TeacherInvitation TeacherInvitation[]
  teachers          TeacherProfile[]

  @@index([slug])
  @@index([status])
  @@index([createdByUserId])
}

model ReservedSlug {
  id        String   @id @default(cuid())
  slug      String   @unique
  reason    String?
  createdAt DateTime @default(now())
}

model OrganizationSubscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  plan                 SubscriptionPlan   @default(TRIAL)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  trialEndsAt          DateTime?
  currentPeriodEndsAt  DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([plan, status])
  @@index([trialEndsAt])
}

model OrganizationSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  defaultLocale        String       @default("en")
  timezone             String       @default("Asia/Kuala_Lumpur")
  currency             String       @default("MYR")
  phone                String?
  email                String?
  addressLine1         String?
  addressLine2         String?
  city                 String?
  state                String?
  postcode             String?
  country              String       @default("MY")
  invoicePrefix        String       @default("INV")
  receiptPrefix        String       @default("RCP")
  defaultInvoiceDueDay Int          @default(7)
  paymentInstructions  String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model OrganizationMembership {
  id             String           @id @default(cuid())
  externalId     String?          @unique
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, role])
  @@index([userId, status])
}

model Branch {
  id             String           @id @default(cuid())
  organizationId String           @unique
  name           String
  isDefault      Boolean          @default(false)
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postcode       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  classes        LearningClass[]
  students       Student[]
  teachers       TeacherProfile[]

  @@index([organizationId, isDefault])
}

model Student {
  id                String             @id @default(cuid())
  organizationId    String
  branchId          String?
  code              String
  fullName          String
  preferredName     String?
  dateOfBirth       DateTime?
  gender            Gender?
  phone             String?
  email             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postcode          String?
  schoolName        String?
  photoUrl          String?
  enrolledAt        DateTime           @default(now())
  status            StudentStatus      @default(ACTIVE)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  archivedAt        DateTime?
  attendanceRecords AttendanceRecord[]
  enrollments       Enrollment[]
  invoices          Invoice[]
  payments          Payment[]
  branch            Branch?            @relation(fields: [branchId], references: [id])
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  guardians         StudentGuardian[]
  level             Level?             @relation("StudentLevel", fields: [levelId], references: [id])
  levelId           String?

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, fullName])
  @@index([branchId])
}

model Guardian {
  id             String            @id @default(cuid())
  organizationId String
  fullName       String
  phone          String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postcode       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  students       StudentGuardian[]

  @@index([organizationId, fullName])
  @@index([organizationId, phone])
}

model StudentGuardian {
  id              String               @id @default(cuid())
  studentId       String
  guardianId      String
  relationship    GuardianRelationship @default(GUARDIAN)
  isPrimary       Boolean              @default(false)
  receivesBilling Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  guardian        Guardian             @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student         Student              @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@index([studentId, isPrimary])
}

model TeacherProfile {
  id             String          @id @default(cuid())
  organizationId String
  branchId       String?
  code           String
  fullName       String
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archivedAt     DateTime?
  userId         String?
  classes        LearningClass[]
  branch         Branch?         @relation(fields: [branchId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  User           User?           @relation(fields: [userId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, fullName])
  @@index([organizationId, archivedAt])
  @@index([branchId])
  @@index([userId])
}

model Subject {
  id             String          @id @default(cuid())
  organizationId String
  code           String
  name           String
  description    String?
  status         SubjectStatus   @default(ACTIVE)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archivedAt     DateTime?
  classes        LearningClass[]
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, status])
}

model Level {
  id             String          @id @default(cuid())
  organizationId String
  code           String
  name           String
  stage          LevelStage      @default(GENERAL)
  order          Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archivedAt     DateTime?
  classes        LearningClass[] @relation("ClassLevel")
  students       Student[]       @relation("StudentLevel")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name], where: { archivedAt: null })
  @@unique([organizationId, code], where: { archivedAt: null })
  @@index([organizationId, archivedAt])
}

model LearningClass {
  id             String            @id @default(cuid())
  organizationId String
  branchId       String?
  subjectId      String
  teacherId      String?
  code           String
  name           String
  academicYear   Int
  dayOfWeek      DayOfWeek
  startsAt       String
  endsAt         String
  room           String?
  capacity       Int?
  monthlyFeeSen  Int               @default(0)
  status         ClassStatus       @default(ACTIVE)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  archivedAt     DateTime?
  sessions       ClassSession[]
  enrollments    Enrollment[]
  invoiceLines   InvoiceLineItem[]
  branch         Branch?           @relation(fields: [branchId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subject        Subject           @relation(fields: [subjectId], references: [id])
  teacher        TeacherProfile?   @relation(fields: [teacherId], references: [id])
  level          Level?            @relation("ClassLevel", fields: [levelId], references: [id])
  levelId        String?

  @@unique([organizationId, name])
  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, dayOfWeek])
  @@index([subjectId])
  @@index([teacherId])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  studentId      String
  classId        String
  startsOn       DateTime         @default(now())
  endsOn         DateTime?
  status         EnrollmentStatus @default(ACTIVE)
  customFeeSen   Int?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  archivedAt     DateTime?
  class          LearningClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, status])
  @@index([organizationId, status])
  @@index([classId, status])
  @@index([studentId, status])
}

model ClassSession {
  id             String             @id @default(cuid())
  organizationId String
  classId        String
  sessionDate    DateTime
  startsAt       String
  endsAt         String
  status         ClassSessionStatus @default(SCHEDULED)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  cancelledAt    DateTime?
  attendance     AttendanceRecord[]
  class          LearningClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([classId, sessionDate])
  @@index([organizationId, sessionDate])
  @@index([classId, status])
}

model AttendanceRecord {
  id             String           @id @default(cuid())
  organizationId String
  sessionId      String
  studentId      String
  status         AttendanceStatus
  notes          String?
  markedByUserId String?
  markedAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  markedBy       User?            @relation(fields: [markedByUserId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  session        ClassSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([organizationId, status])
  @@index([studentId, markedAt])
}

model Invoice {
  id             String              @id @default(cuid())
  organizationId String
  studentId      String
  invoiceNumber  String
  billingMonth   String
  issueDate      DateTime            @default(now())
  dueDate        DateTime
  status         InvoiceStatus       @default(ISSUED)
  subtotalSen    Int                 @default(0)
  discountSen    Int                 @default(0)
  totalSen       Int                 @default(0)
  amountPaidSen  Int                 @default(0)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  voidedAt       DateTime?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  student        Student             @relation(fields: [studentId], references: [id])
  lineItems      InvoiceLineItem[]
  allocations    PaymentAllocation[]

  @@unique([organizationId, invoiceNumber])
  @@unique([organizationId, studentId, billingMonth])
  @@index([organizationId, billingMonth])
  @@index([organizationId, status])
  @@index([studentId])
}

model InvoiceLineItem {
  id           String         @id @default(cuid())
  invoiceId    String
  classId      String?
  description  String
  quantity     Int            @default(1)
  unitPriceSen Int
  totalSen     Int
  createdAt    DateTime       @default(now())
  class        LearningClass? @relation(fields: [classId], references: [id])
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([classId])
}

model Payment {
  id               String              @id @default(cuid())
  organizationId   String
  studentId        String
  receiptNumber    String
  amountSen        Int
  method           PaymentMethod
  status           PaymentStatus       @default(RECORDED)
  paidAt           DateTime            @default(now())
  reference        String?
  notes            String?
  recordedByUserId String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  reversedAt       DateTime?
  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recordedBy       User?               @relation(fields: [recordedByUserId], references: [id])
  student          Student             @relation(fields: [studentId], references: [id])
  allocations      PaymentAllocation[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId, paidAt])
  @@index([studentId])
}

model PaymentAllocation {
  id        String   @id @default(cuid())
  paymentId String
  invoiceId String
  amountSen Int
  createdAt DateTime @default(now())
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment   Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  status      WebhookStatus @default(PROCESSING)
  error       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([provider, eventId])
  @@index([provider, eventType])
  @@index([status])
}

model AuditEvent {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  action         AuditAction
  targetType     String
  targetId       String?
  summary        String
  metadata       Json?
  createdAt      DateTime      @default(now())
  actor          User?         @relation("ActorAuditEvents", fields: [actorUserId], references: [id])
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model TeacherInvitation {
  id                                            String           @id @default(cuid())
  organizationId                                String
  email                                         String
  fullName                                      String
  token                                         String           @unique
  status                                        InvitationStatus @default(PENDING)
  invitedByUserId                               String?
  acceptedByUserId                              String?
  expiresAt                                     DateTime
  acceptedAt                                    DateTime?
  createdAt                                     DateTime         @default(now())
  updatedAt                                     DateTime         @updatedAt
  revokedAt                                     DateTime?
  User_TeacherInvitation_acceptedByUserIdToUser User?            @relation("TeacherInvitation_acceptedByUserIdToUser", fields: [acceptedByUserId], references: [id])
  User_TeacherInvitation_invitedByUserIdToUser  User?            @relation("TeacherInvitation_invitedByUserIdToUser", fields: [invitedByUserId], references: [id])
  Organization                                  Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, email, status])
  @@index([email, status])
  @@index([expiresAt])
  @@index([organizationId, status])
  @@index([token, status])
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum MembershipRole {
  OWNER
  ADMIN
  TEACHER
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum WebhookStatus {
  PROCESSING
  PROCESSED
  FAILED
}

enum AuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
  ACCESS
  SYSTEM
}

enum StudentStatus {
  ACTIVE
  ARCHIVED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  GUARDIAN
  OTHER
}

enum SubjectStatus {
  ACTIVE
  ARCHIVED
}

enum LevelStage {
  PRIMARY
  LOWER_SECONDARY
  UPPER_SECONDARY
  PRE_UNIVERSITY
  GENERAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ClassStatus {
  ACTIVE
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  ENDED
  ARCHIVED
}

enum ClassSessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  DUITNOW
  FPX
  CARD
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  UNPAID
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}
